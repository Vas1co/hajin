<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows (IIS) sunucusu için ayarlar. Plesk'teki hosting Windows olduğu için bu dosya sitenin klasöründe,
  index.html'in yanında durmalı. Linux sunucularda ve dosyaya çift tıklayınca açarken etkisi yok.
-->
<configuration>
  <system.webServer>
    <!-- Adres yazılınca index.html açılsın -->
    <defaultDocument>
      <files>
        <remove value="index.html" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <!-- Bazı sunucular .webp resimlerini tanımıyor; o zaman haritadaki DMZHub ikonları görünmez -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>

  <!-- Harita karoları hiç değişmiyor, tarayıcı bir hafta saklasın ki harita hızlı açılsın -->
  <location path="harita/tiles">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
